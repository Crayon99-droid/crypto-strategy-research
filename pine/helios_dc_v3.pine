//@version=6
strategy(
     "HELIOS DC BUG HARVEST v3",
     overlay = true,
     initial_capital = 1000,
     default_qty_type = strategy.percent_of_equity,
     default_qty_value = 100,
     pyramiding = 0,
     commission_type = strategy.commission.percent,
     commission_value = 0.055,
     slippage = 2,
     calc_on_order_fills = false)

// IMPORTANT
// Run this on ETHUSDT.P, 1-minute bars.
// 0.055% per side is a placeholder taker fee. Match both the strategy()
// commission_value above and feePerSidePct below to your actual account fee.
// calc_on_order_fills=false intentionally preserves the original strategy's
// one-bar order-activation delay. All modes in this file are research modes,
// not live-safe execution policies.

// ─────────────────────────────────────────────────────────────────────────────
// Experiment controls
// ─────────────────────────────────────────────────────────────────────────────
experimentGroup = "A. CONTROLLED EXPERIMENT"

exitMode = input.string(
     "Legacy bug replay",
     "Exit architecture",
     options = ["Legacy bug replay", "One-bar burst diagnostic", "Capped recovery", "Full bracket control"],
     group = experimentGroup,
     tooltip = "Change only this input when comparing exit behavior. Legacy replay reproduces the original delayed orders and unprotected half. One-bar burst tests whether the delayed first-bar exit was the useful mechanism.")

signalSourceMode = input.string(
     "Raw close (legacy)",
     "Direction-change source",
     options = ["Raw close (legacy)", "Smoothed close"],
     group = experimentGroup,
     tooltip = "The original script calculated smoothedPrice but used raw close. Keep Raw close for the legacy control.")

// ─────────────────────────────────────────────────────────────────────────────
// Direction-change signal
// ─────────────────────────────────────────────────────────────────────────────
signalGroup = "B. SIGNAL"

thresholdPercent = input.float(3.0, "Direction-change threshold (%)", minval = 0.1, step = 0.1, group = signalGroup)
smoothingPeriod = input.int(14, "Smoothing period", minval = 1, group = signalGroup)
smaLength = input.int(200, "Trend SMA length", minval = 1, group = signalGroup)
showSignals = input.bool(true, "Show signal arrows", group = signalGroup)
showBands = input.bool(true, "Show direction bands", group = signalGroup)

useStricterShortCriteria = input.bool(true, "Use legacy strict short filter", group = signalGroup)
rsiLength = input.int(14, "RSI length", minval = 1, group = signalGroup)
shortRsiThreshold = input.int(40, "Short RSI maximum", minval = 0, maxval = 100, group = signalGroup)
volumeLength = input.int(20, "Volume average length", minval = 1, group = signalGroup)
volumeMultiplier = input.float(1.5, "High-volume multiplier", minval = 0.1, step = 0.1, group = signalGroup)

// ─────────────────────────────────────────────────────────────────────────────
// Core risk parameters
// ─────────────────────────────────────────────────────────────────────────────
riskGroup = "C. CORE BRACKET"

longRiskPercent = input.float(1.0, "Long stop (%)", minval = 0.1, step = 0.1, group = riskGroup)
longRewardPercent = input.float(2.0, "Long target (%)", minval = 0.1, step = 0.1, group = riskGroup)
shortRiskPercent = input.float(0.8, "Short stop (%)", minval = 0.1, step = 0.1, group = riskGroup)
shortRewardPercent = input.float(1.5, "Short target (%)", minval = 0.1, step = 0.1, group = riskGroup)

// ─────────────────────────────────────────────────────────────────────────────
// Recovery-half parameters
// ─────────────────────────────────────────────────────────────────────────────
recoveryGroup = "D. RECOVERY HALF"

legacyLongRecoveryTarget = input.float(1.0, "Legacy long recovery target (%)", minval = 0.1, step = 0.05, group = recoveryGroup)
legacyShortRecoveryTarget = input.float(0.75, "Legacy short recovery target (%)", minval = 0.1, step = 0.05, group = recoveryGroup)

feePerSidePct = input.float(0.055, "Fee per side used in recovery math (%)", minval = 0.0, step = 0.001, group = recoveryGroup)
desiredNetEdgePct = input.float(0.05, "Desired net setup edge after recovery (%)", minval = 0.0, step = 0.01, group = recoveryGroup)
catastrophicStopPct = input.float(3.0, "Recovery catastrophic stop (%)", minval = 0.2, step = 0.1, group = recoveryGroup)
maxHoldBars = input.int(720, "Maximum holding bars", minval = 1, group = recoveryGroup, tooltip = "720 bars equals 12 hours on the intended 1-minute chart.")
closeRecoveryOnOppositeDC = input.bool(true, "Close recovery on opposite DC", group = recoveryGroup)

// If half the trade loses R%, the other half must gain at least R% plus twice
// the full-position round-trip cost to bring the entire setup back above zero.
roundTripFeePct = 2.0 * feePerSidePct
costAwareLongRecoveryPct = longRiskPercent + 2.0 * (roundTripFeePct + desiredNetEdgePct)
costAwareShortRecoveryPct = shortRiskPercent + 2.0 * (roundTripFeePct + desiredNetEdgePct)
burstExitThresholdPct = roundTripFeePct + desiredNetEdgePct

// ─────────────────────────────────────────────────────────────────────────────
// Indicators and entry filters
// ─────────────────────────────────────────────────────────────────────────────
threshold = thresholdPercent / 100.0
smoothedPrice = ta.sma(close, smoothingPeriod)
directionPrice = signalSourceMode == "Raw close (legacy)" ? close : smoothedPrice

smaFilter = ta.sma(close, smaLength)
rsiValue = ta.rsi(close, rsiLength)
volumeMA = ta.sma(volume, volumeLength)
highVolume = volume > volumeMA * volumeMultiplier

longCondition = close > smaFilter
shortCondition = close < smaFilter
improvedShortCondition = shortCondition and (not useStricterShortCriteria or (rsiValue < shortRsiThreshold and highVolume))

// ─────────────────────────────────────────────────────────────────────────────
// Direction-change state machine
// This deliberately retains the original raw high/low anchors.
// ─────────────────────────────────────────────────────────────────────────────
var float lastHigh = na
var float lastLow = na
var int trendDirection = 0

if na(lastHigh) and na(lastLow)
    lastHigh := high
    lastLow := low

previousDirection = trendDirection
bool buySignal = false
bool sellSignal = false

if trendDirection >= 0 and directionPrice < lastHigh * (1.0 - threshold)
    trendDirection := -1
    lastLow := low
    sellSignal := previousDirection == 1

if trendDirection <= 0 and directionPrice > lastLow * (1.0 + threshold)
    trendDirection := 1
    lastHigh := high
    buySignal := previousDirection == -1

if trendDirection == 1 and high > lastHigh
    lastHigh := high

if trendDirection == -1 and low < lastLow
    lastLow := low

// Keep the original reversal behavior: strategy.entry in the opposite direction
// reverses an open position if its complete entry filter is satisfied.
if buySignal and longCondition
    strategy.entry("Long", strategy.long)

if sellSignal and improvedShortCondition
    strategy.entry("Short", strategy.short)

// ─────────────────────────────────────────────────────────────────────────────
// Holding-time state
// ─────────────────────────────────────────────────────────────────────────────
var int positionEntryBar = na

newLongPosition = strategy.position_size > 0 and strategy.position_size[1] <= 0
newShortPosition = strategy.position_size < 0 and strategy.position_size[1] >= 0

if newLongPosition or newShortPosition
    positionEntryBar := bar_index

if strategy.position_size == 0
    positionEntryBar := na

heldBars = na(positionEntryBar) ? 0 : bar_index - positionEntryBar

// ─────────────────────────────────────────────────────────────────────────────
// Exit architecture
// No trailing stops are used in any mode.
// ─────────────────────────────────────────────────────────────────────────────
if strategy.position_size > 0
    entryPrice = strategy.position_avg_price
    coreStop = entryPrice * (1.0 - longRiskPercent / 100.0)
    coreTarget = entryPrice * (1.0 + longRewardPercent / 100.0)
    legacyRecoveryTargetPrice = entryPrice * (1.0 + legacyLongRecoveryTarget / 100.0)
    cappedRecoveryTargetPrice = entryPrice * (1.0 + costAwareLongRecoveryPct / 100.0)
    catastrophicStopPrice = entryPrice * (1.0 - catastrophicStopPct / 100.0)

    if exitMode == "Full bracket control"
        strategy.exit("Long Full", "Long", stop = coreStop, limit = coreTarget, qty_percent = 100)

    else if exitMode == "Legacy bug replay"
        // Exact architecture of the useful old mistake:
        // only 50% is protected by the core bracket. The other half receives
        // its limit only after the bar has already touched the trigger.
        strategy.exit("Long Core Legacy", "Long", stop = coreStop, limit = coreTarget, qty_percent = 50)
        if high >= legacyRecoveryTargetPrice
            strategy.exit("Long Recovery Legacy", "Long", limit = legacyRecoveryTargetPrice, qty_percent = 50)

    else if exitMode == "One-bar burst diagnostic"
        // The original script knew the entry had filled only when the entry bar
        // closed. Its exits therefore became active one bar late. This mode
        // deliberately tests that behavior without partial exits or trailing.
        longGrossReturnPct = (close / entryPrice - 1.0) * 100.0
        if heldBars == 0 and longGrossReturnPct >= burstExitThresholdPct
            strategy.close("Long", comment = "One-bar burst")
        else
            strategy.exit("Long Burst Bracket", "Long", stop = coreStop, limit = coreTarget, qty_percent = 100)

    else
        // Executable version of the hypothesis: the second half is allowed more
        // room to recover, but its maximum loss and holding time are finite.
        strategy.exit("Long Core Capped", "Long", stop = coreStop, limit = coreTarget, qty_percent = 50)
        strategy.exit("Long Recovery Capped", "Long", stop = catastrophicStopPrice, limit = cappedRecoveryTargetPrice, qty_percent = 50)

        if closeRecoveryOnOppositeDC and sellSignal
            strategy.close("Long", comment = "Opposite DC")
        else if heldBars >= maxHoldBars
            strategy.close("Long", comment = "Time stop")

else if strategy.position_size < 0
    entryPrice = strategy.position_avg_price
    coreStop = entryPrice * (1.0 + shortRiskPercent / 100.0)
    coreTarget = entryPrice * (1.0 - shortRewardPercent / 100.0)
    legacyRecoveryTargetPrice = entryPrice * (1.0 - legacyShortRecoveryTarget / 100.0)
    cappedRecoveryTargetPrice = entryPrice * (1.0 - costAwareShortRecoveryPct / 100.0)
    catastrophicStopPrice = entryPrice * (1.0 + catastrophicStopPct / 100.0)

    if exitMode == "Full bracket control"
        strategy.exit("Short Full", "Short", stop = coreStop, limit = coreTarget, qty_percent = 100)

    else if exitMode == "Legacy bug replay"
        strategy.exit("Short Core Legacy", "Short", stop = coreStop, limit = coreTarget, qty_percent = 50)
        if low <= legacyRecoveryTargetPrice
            strategy.exit("Short Recovery Legacy", "Short", limit = legacyRecoveryTargetPrice, qty_percent = 50)

    else if exitMode == "One-bar burst diagnostic"
        shortGrossReturnPct = (1.0 - close / entryPrice) * 100.0
        if heldBars == 0 and shortGrossReturnPct >= burstExitThresholdPct
            strategy.close("Short", comment = "One-bar burst")
        else
            strategy.exit("Short Burst Bracket", "Short", stop = coreStop, limit = coreTarget, qty_percent = 100)

    else
        strategy.exit("Short Core Capped", "Short", stop = coreStop, limit = coreTarget, qty_percent = 50)
        strategy.exit("Short Recovery Capped", "Short", stop = catastrophicStopPrice, limit = cappedRecoveryTargetPrice, qty_percent = 50)

        if closeRecoveryOnOppositeDC and buySignal
            strategy.close("Short", comment = "Opposite DC")
        else if heldBars >= maxHoldBars
            strategy.close("Short", comment = "Time stop")

// ─────────────────────────────────────────────────────────────────────────────
// Visual diagnostics
// ─────────────────────────────────────────────────────────────────────────────
upBand = trendDirection == 1 ? lastHigh : na
downBand = trendDirection == -1 ? lastLow : na

plot(showBands ? upBand : na, "Upper Band", color = color.green, linewidth = 2)
plot(showBands ? downBand : na, "Lower Band", color = color.red, linewidth = 2)
plot(smaFilter, "Trend SMA", color = color.yellow, linewidth = 1)

plotshape(showSignals and buySignal and longCondition, title = "Buy Signal", location = location.belowbar, color = color.green, style = shape.triangleup, size = size.small)
plotshape(showSignals and sellSignal and improvedShortCondition, title = "Sell Signal", location = location.abovebar, color = color.red, style = shape.triangledown, size = size.small)

bgcolor(trendDirection == 1 ? color.new(color.green, 92) : trendDirection == -1 ? color.new(color.red, 92) : na)

var table diagnostics = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    table.cell(diagnostics, 0, 0, "Exit mode")
    table.cell(diagnostics, 1, 0, exitMode)
    table.cell(diagnostics, 0, 1, "Signal source")
    table.cell(diagnostics, 1, 1, signalSourceMode)
    table.cell(diagnostics, 0, 2, "Chart TF")
    table.cell(diagnostics, 1, 2, timeframe.period, bgcolor = timeframe.period == "1" ? color.new(color.green, 70) : color.new(color.red, 40))
    table.cell(diagnostics, 0, 3, "Capped L target")
    table.cell(diagnostics, 1, 3, str.tostring(costAwareLongRecoveryPct, "#.###") + "%")
    table.cell(diagnostics, 0, 4, "Capped S target")
    table.cell(diagnostics, 1, 4, str.tostring(costAwareShortRecoveryPct, "#.###") + "%")

alertcondition(buySignal and longCondition, title = "Buy Signal", message = "HELIOS direction change: BUY")
alertcondition(sellSignal and improvedShortCondition, title = "Sell Signal", message = "HELIOS direction change: SELL")
